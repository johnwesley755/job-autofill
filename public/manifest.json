{
  "manifest_version": 3,
  "name": "AutoApply - Universal Job Application Autofill Assistant",
  "version": "1.0.0",
  "description": "Intelligent, privacy-conscious job application assistant for universal ATS forms.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "AutoApply Assistant"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.greenhouse.io/*",
        "*://*.lever.co/*",
        "*://*.myworkdayjobs.com/*",
        "*://*.ashbyhq.com/*",
        "*://docs.google.com/forms/*",
        "*://forms.gle/*",
        "*://forms.office.com/*",
        "*://forms.microsoft.com/*",
        "*://forms.zoho.com/*",
        "*://forms.zohopublic.com/*",
        "*://forms.zohopublic.in/*",
        "*://recruit.zoho.com/*",
        "*://recruit.zoho.in/*",
        "*://*.zohorecruit.com/*",
        "*://app.keka.com/*",
        "*://*.keka.com/*",
        "*://*/*job*/*",
        "*://*/*career*/*",
        "*://*/*apply*/*"
      ],
      "js": ["content.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "*://*.greenhouse.io/*",
    "*://*.lever.co/*",
    "*://*.myworkdayjobs.com/*",
    "*://*.ashbyhq.com/*",
    "*://docs.google.com/forms/*",
    "*://forms.gle/*",
    "*://forms.office.com/*",
    "*://forms.microsoft.com/*",
    "*://forms.zoho.com/*",
    "*://forms.zohopublic.com/*",
    "*://forms.zohopublic.in/*",
    "*://recruit.zoho.com/*",
    "*://recruit.zoho.in/*",
    "*://*.zohorecruit.com/*",
    "*://app.keka.com/*",
    "*://*.keka.com/*"
  ]
}
